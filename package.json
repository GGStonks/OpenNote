{
  "name": "opennote",
  "private": true,
  "version": "2.4.5",
  "type": "module",
  "scripts": {
    "copy-tikzjax": "node scripts/copy-tikzjax.mjs",
    "dev": "npm run copy-tikzjax && vite --host 0.0.0.0 --port 5173",
    "build": "npm run test:engine && npm run test:storage && npm run copy-tikzjax && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "bench:pen": "esbuild bench/pen.ts --bundle --platform=node --format=esm --log-level=error --outfile=node_modules/.cache/pen-bench.mjs && node node_modules/.cache/pen-bench.mjs",
    "bench:replay": "esbuild bench/replay.ts --bundle --platform=node --format=esm --log-level=error --outfile=node_modules/.cache/pen-replay.mjs && node node_modules/.cache/pen-replay.mjs",
    "test:engine": "esbuild bench/engineGolden.ts --bundle --platform=node --format=esm --log-level=error --outfile=node_modules/.cache/engine-golden.mjs && node node_modules/.cache/engine-golden.mjs",
    "bench:overshoot": "esbuild bench/overshoot.ts --bundle --platform=node --format=esm --log-level=error --outfile=node_modules/.cache/overshoot.mjs && node node_modules/.cache/overshoot.mjs",
    "bench:live": "esbuild bench/liveLine.ts --bundle --platform=node --format=esm --log-level=error --outfile=node_modules/.cache/live-line.mjs && node node_modules/.cache/live-line.mjs",
    "test:storage": "esbuild bench/storageRoundtrip.ts --bundle --platform=node --format=esm --log-level=error --outfile=node_modules/.cache/storage-roundtrip.mjs && node node_modules/.cache/storage-roundtrip.mjs",
    "bench:ui": "vite build --minify false && node bench/ui.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/share": "^8.0.3",
    "@drgrice1/tikzjax": "^1.0.0-beta24",
    "katex": "^0.16.21",
    "lucide-react": "^0.575.0",
    "pdf-lib": "1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
